# Node modules
node_modules/
# package-lock.json est VERSIONNÉ : sans lui, Vercel résolvait prettier 3.9.6 (local 3.8.3)
# et le build échouait sur prettier/prettier. `npm ci` garantit local = Vercel.

# Next.js build output
.next/
out/

# Production build
build/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS-specific files
.DS_Store
Thumbs.db

# Vercel deployment
.vercel/

# Optional: if using TypeScript
*.tsbuildinfo

# Optional: if using testing tools
coverage/
jest-test-results.json

# Optional: if using IDEs
.vscode/
.idea/

# Optional: if using TurboRepo or monorepo
turbo/

# Local env (secrets — never commit)
.env
.env.local
.env.*.local
.env.production
# .env.example IS committed (template with placeholders)
!.env.example

# AutoSwap dry-run outputs (contiennent des données clients)
autoswap-proposals.md
autoswap-proposals.json

# Claude Code local state (worktrees, settings)
.claude/